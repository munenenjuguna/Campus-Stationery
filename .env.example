# Copy this file to .env and change the values for your computer.
# .env is never uploaded to GitHub, so passwords stay on your machine.

# ---- Web server ----
PORT=5000

# ---- MySQL / MariaDB (XAMPP) ----
# In phpMyAdmin the top bar shows "Server: 127.0.0.1:3306". Use that port number here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=school_project_db

# ---- Online database (only when the system is hosted) ----
# Instead of the five settings above you can paste one address from your provider:
# DATABASE_URL=mysql://user:password@host:4000/school_project_db
# Online databases need an encrypted connection:
# DB_SSL=true
# Only if your provider gives you a certificate file to paste (keep the \n line breaks):
# DB_SSL_CA=
# Online servers usually run on UTC. +03:00 keeps order times in Kenya time:
# DB_TIMEZONE=+03:00

# ---- Login tokens (optional) ----
# Signs logins and encrypts authenticator app keys.
# On a laptop leave it empty and a random secret is created automatically in .app-secret.
# When hosted online ALWAYS set it (Render does this for you), or logins reset on every restart.
APP_SECRET=

# ---- M-Pesa (optional) ----
# Leave empty to use demo mode (payments are simulated, good for presentations).
# For the real Daraja sandbox, create an app at developer.safaricom.co.ke and paste its keys.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Only needed when the system is hosted online with a public https address
MPESA_CALLBACK_URL=

# ---- Email for "forgot password" and sign in codes (optional) ----
# Leave empty and the reset link and sign in codes are printed in the server window instead.
# Note: Render's free plan blocks email sending ports, so on Render use an authenticator app for admins.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
